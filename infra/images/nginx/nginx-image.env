# Official nginx base image parameters for infra/images/nginx/Dockerfile.
# Keep the tag/version and digest here so the Dockerfile remains reusable.
#
# Update NGINX_IMAGE_DIGEST to the digest of the exact official nginx tag before building.
# Example lookup:
#   docker buildx imagetools inspect nginx:${NGINX_VERSION}
NGINX_VERSION=1.27.5-bookworm
NGINX_IMAGE_DIGEST=sha256:REPLACE_WITH_OFFICIAL_NGINX_IMAGE_DIGEST

# Destination image built from the pinned official nginx image plus the checked-in modules.
NGINX_CUSTOM_IMAGE=REPLACE_WITH_REGISTRY.azurecr.io/dify-nginx:${NGINX_VERSION}
